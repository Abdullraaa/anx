# Local dev targets the anx-dev Supabase project, NOT production.
# The URL and the key must come from the SAME project — a production URL beside
# an anx-dev key (or vice versa) fails every call with "Invalid API key".
#   anx-dev     yzkebxfcffpqizxrxffv   <- use this locally
#   production  csqwqrujunejbyjbqgxc   <- deployed backend only; Vercel holds its own vars
SUPABASE_URL=https://yzkebxfcffpqizxrxffv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-anx-dev-service-role-key
PORT=3000
