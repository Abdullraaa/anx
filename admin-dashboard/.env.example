# Local dev targets the anx-dev Supabase project, NOT production.
# The URL and anon key must come from the SAME project; the key's `ref` claim
# must match the URL's subdomain.
#   anx-dev     yzkebxfcffpqizxrxffv   <- use this locally
#   production  csqwqrujunejbyjbqgxc   <- Vercel holds its own vars
VITE_SUPABASE_URL=https://yzkebxfcffpqizxrxffv.supabase.co
VITE_SUPABASE_ANON_KEY=your-anx-dev-anon-key
# Point at the locally-running backend. Use the machine's LAN/Tailscale IP rather
# than localhost so a phone on the same network can reach it.
VITE_API_URL=http://<your-lan-ip>:3000
