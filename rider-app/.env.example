# Local dev (Expo Go) targets the anx-dev Supabase project, NOT production.
# The URL and anon key must come from the SAME project.
#   anx-dev     yzkebxfcffpqizxrxffv   <- use this locally
#   production  csqwqrujunejbyjbqgxc
EXPO_PUBLIC_SUPABASE_URL=https://yzkebxfcffpqizxrxffv.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anx-dev-anon-key
# Locally: the machine's LAN/Tailscale IP (localhost won't resolve from a device).
# eas build does NOT read this file — it uses the vars stored on EAS, which point
# at the deployed backend. Changing this cannot affect an APK build.
EXPO_PUBLIC_API_URL=http://<your-lan-ip>:3000
